# MAINNET settings for the MAIN HOST (real ZEC): copy to /home/gunit/zec-ecash/mainnet/.env,
#   install -m 600 deploy/mainnet.env.example mainnet/.env
# fill in the values, and keep it mode 600. No secrets are in this example; the real file holds
# one (CDK_MINTD_MNEMONIC). Read by zec-processor, cdk-mintd (via zec-mintd.service), the point
# of sale (zec-pos.service), zec-ecash-cli, the web build (ZEC_ENV_FILE=../mainnet/.env) and
# scripts/mainnet-up.sh.
# ZEC_NETWORK is NOT read from here: the systemd units set ZEC_NETWORK=mainnet themselves.
# Relative paths are relative to /home/gunit/zec-ecash (the units' working directory).
# Guardian 1 on this host has its own file, /home/gunit/mainnet/.env (deploy/guardian.env.example).

# --- the mint -----------------------------------------------------------------------------
# The mint's public URL: what wallets use and tokens carry. Must equal [info] url in
# mintd/config.mainnet.toml (without the trailing slash) and the guardians' ZEC_MINT_URL.
ZEC_MINT_URL=https://zecmint.duckdns.org/mint
# Extra CA for the mint URL, only if it is NOT a public certificate (Caddy's Let's Encrypt one
# is public: leave empty).
ZEC_MINT_CA=
# The mint's ecash signing key: 24 BIP-39 words, generated offline for this mint only (never the
# devnet's), backed up. Quoted, because it contains spaces. zec-processor.service unsets it.
CDK_MINTD_MNEMONIC="<24 words>"

# --- chain access -------------------------------------------------------------------------
# Light-wallet gRPC server; https:// uses TLS (web roots). Your own lightwalletd/Zebra is safer
# than a public one (it sees the mint's addresses and txids, and the reorg handling trusts it).
ZEC_LWD_URL=https://zec.rocks:443
# Depth before a deposit is PAID, a withdrawal settles, and a note counts as reserve (mainnet
# default 10, about 12.5 minutes).
ZEC_MIN_CONFIRMATIONS=10
# Seconds between sync passes (deposits, withdrawals, reorg checks, reserve check).
ZEC_SYNC_INTERVAL_SECS=7

# --- guardians ----------------------------------------------------------------------------
# Guardian N is the N-th URL; each must be https:// and match the SAN of its certificate
# (scripts/guardian-ca.sh issue mainnet/ca N <host-or-ip>). Guardian 1 runs on this host.
ZEC_GUARDIANS=https://127.0.0.1:8101,https://<GUARDIAN2_IP>:8102,https://<GUARDIAN3_HOST>:8103
# CA that issued the guardians' certificates (default mainnet/keys/guardian-ca.crt).
ZEC_GUARDIAN_CA=mainnet/keys/guardian-ca.crt
# Directory holding guardian-1.auth, guardian-2.auth, guardian-3.auth (default mainnet/keys).
ZEC_GUARDIAN_AUTH_DIR=mainnet/keys
# Per-round timeout for guardian requests, seconds.
ZEC_GUARDIAN_TIMEOUT_SECS=30

# --- limits (keep equal to mintd/config.mainnet.toml) ---------------------------------------
# Smallest / largest deposit and withdrawal, zats (= min_mint/min_melt, max_mint/max_melt).
# Not below 10000: a note of 5,000 zat or less is dust a withdrawal can never spend.
ZEC_MIN_ZATS=10000
ZEC_MAX_ZATS=1000000
# Refuse deposit quotes that could push the whole reserve past this, zats.
ZEC_MAX_RESERVE=1000000

# --- point of sale (zec-pos.service, crates/pos) --------------------------------------------
# It accepts payments only at ZEC_MINT_URL above (https://zecmint.duckdns.org/mint) and only in
# unit zat, P2PK-locked to the payee phone's per-request key: it checks and stores them, the
# phone collects them, and it never holds spendable money. Its (legacy) wallet seed is
# mainnet/keys/pos-wallet.seed: created once, mode 600, never overwritten, with
#   ZEC_NETWORK=mainnet ./target/release/zec-ecash-cli --wallet pos init
# Its state (requests and stored payments, legacy wallet, admin socket) is in mainnet/pos/.
# The public URL its payment requests advertise (wallets POST payments to <this>/payment);
# Caddy proxies it to ZEC_POS_ADDR. Must be https:// on mainnet.
ZEC_POS_URL=https://zecmint.duckdns.org/pos
# Where it listens: loopback only (it refuses anything else on mainnet).
ZEC_POS_ADDR=127.0.0.1:9090

# --- files and ports (defaults shown; change only with a reason) ---------------------------
ZEC_MINT_UFVK=mainnet/keys/mint.ufvk
ZEC_FROST_PUBKEYS=mainnet/keys/frost-pubkeys.json
ZEC_MINT_DB=mainnet/mint-reserve.sqlite
ZEC_PROCESSOR_DB=mainnet/processor.sqlite
ZEC_CDK_MINT_DB=mainnet/mint/cdk-mintd.sqlite
# The processor's gRPC for cdk-mintd ([grpc_processor] port in mintd/config.mainnet.toml).
ZEC_GRPC_ADDR=127.0.0.1:51051
# /reserves, /deposit-quote, /withdrawal-quote (Caddy proxies them).
ZEC_STATUS_ADDR=127.0.0.1:9095
# Log directory for zec-processor (default mainnet/logs).
ZEC_LOG_DIR=mainnet/logs
# Log filter for our binaries (default info,zcash_client_backend=warn,zcash_client_sqlite=warn).
#RUST_LOG=info

# --- scripts/mainnet-up.sh only (not used by the systemd units) ------------------------------
# What mainnet-up.sh starts on this host if you use it instead of systemd.
#ZEC_ROLES=processor,mint
