#!/usr/bin/env sh
# 2-of-3 FROST DKG across the three guardian processes, then the mint UFVK.
# Each step is a separate `guardian` process per guardian; they exchange DKG packages
# through devnet/keys/dkg/ (on a real deployment: authenticated, private channels).
# Outputs (all in devnet/keys/): guardian-N.key (secret, one per guardian),
# frost-pubkeys.json, mint.ufvk (Orchard ak = group key; written by the coordinator).
# Normally run by scripts/devnet-reset.sh --new-keys.
set -eu
cd "$(dirname "$0")/.."
K=devnet/keys
for f in $K/guardian-1.key $K/guardian-2.key $K/guardian-3.key $K/frost-pubkeys.json $K/mint.ufvk; do
  if [ -e "$f" ]; then
    echo "$f exists: these keys control the reserve. Use scripts/devnet-reset.sh --new-keys." >&2
    exit 1
  fi
done
cargo build -q -p guardian -p zec-processor
G=./target/debug/guardian
rm -rf $K/dkg
for part in part1 part2 part3; do
  for id in 1 2 3; do $G --id "$id" dkg "$part"; done
done
# Every guardian must have derived the same public key package.
cmp -s $K/dkg/pubkeys-1.json $K/dkg/pubkeys-2.json
cmp -s $K/dkg/pubkeys-1.json $K/dkg/pubkeys-3.json
cp $K/dkg/pubkeys-1.json $K/frost-pubkeys.json
rm -rf $K/dkg
./target/debug/zec-processor make-ufvk
for id in 1 2 3; do $G --id "$id" check-ufvk; done
