# MAINNET settings for a GUARDIAN (real ZEC): copy to /home/gunit/mainnet/.env on the guardian's
# machine (the bare box, or the main host for guardian 1),
#   install -m 600 guardian.env.example ~/mainnet/.env
# and fill in the values. No secrets live in this file; the guardian's secrets are files in
# ~/mainnet/keys/ (guardian-N.key, guardian-N.auth, guardian-N-tls.key).
# Read by zec-guardian@N.service and by the guardian itself. ZEC_NETWORK is NOT read from here:
# the unit sets ZEC_NETWORK=mainnet.

# The mint's public URL. The guardian fetches each withdrawal's quote here (check a) before
# signing, so it must be the public https:// URL, never a local or http:// one.
ZEC_MINT_URL=https://zecmint.duckdns.org/mint

# Where this guardian listens (TLS). The firewall must allow this port from the main host's IP
# only. On the main host (guardian 1): 127.0.0.1:8101. On a separate box: 0.0.0.0:810N.
ZEC_GUARDIAN_LISTEN=0.0.0.0:8102

# Extra CA for ZEC_MINT_URL, only if the mint does NOT use a public certificate (leave empty).
ZEC_MINT_CA=

# Log filter (default info). Logs: ~/mainnet/logs/guardian-N.log, size-capped.
#RUST_LOG=info

# scripts/mainnet-up.sh only (if you run the guardian from a repo checkout instead of systemd).
#ZEC_ROLES=guardian:2
