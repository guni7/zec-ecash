# Note: git has no trailing comments; a "#" after a pattern becomes part of the pattern.

# Build output
target/

# Secrets and local config
.env
.env.*
!.env.example
# Everything that must survive a devnet reset: guardian FROST key shares (secret), wallet
# seeds (secret), the group public keys and the mint UFVK. The CDK mint mnemonic is in .env.
devnet/keys/
# any other wallet seed
*.seed
# per-quote guardian signing records (reset together with the mint DB)
devnet/guardian-*.signed.json

# Wallet, mint and processor databases (SQLite incl. WAL/SHM/journal sidecars, redb)
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
*.redb

# Devnet runtime state: Zebra regtest chain, cdk-mintd work dir (the only mint DB; see
# README), retired mint DBs and wallet backups, logs, scratch output
devnet/zebra-state/
devnet/mint/
devnet/archive/
devnet/*.log
devnet/logs/
devnet/quote.json

# Demo web wallet: dependencies, build output, and the mkcert TLS key/certs (machine-specific)
web/node_modules/
web/dist/
web/certs/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
