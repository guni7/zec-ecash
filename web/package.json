{
  "name": "zec-ecash-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "zec-ecash web wallet: regtest devnet by default, MAINNET when built with ZEC_NETWORK=mainnet",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run.mjs",
    "e2e:devnet": "node --experimental-websocket tests/e2e/devnet.mjs",
    "e2e:beginner": "node --experimental-websocket tests/e2e/beginner.mjs",
    "e2e:audit": "node --experimental-websocket tests/e2e/audit.mjs",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@cashu/cashu-ts": "4.11.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/unbounded": "5.3.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "qr-scanner": "1.4.2",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  }
}
